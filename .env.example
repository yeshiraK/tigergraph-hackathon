# ==========================================
# TigerGraph Agentic GraphRAG Configuration
# ==========================================

# TigerGraph Connection Settings (Mandatory Graph/Vector Store)
TIGERGRAPH_HOST=http://127.0.0.1
TIGERGRAPH_RESTPP_PORT=9000
TIGERGRAPH_GSQL_PORT=14240
TIGERGRAPH_GRAPH_NAME=AgenticGraphRAG
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=
TIGERGRAPH_API_TOKEN=

# TigerGraph MCP Server (Layer 3)
TIGERGRAPH_MCP_SERVER_URL=

# Model / LLM Settings (Source of truth is the corpus; external web search disabled)
# Configured models are used strictly for reasoning over retrieved evidence
LLM_PROVIDER=
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_API_BASE=

# Execution & Telemetry
EXPERIMENT_OUTPUT_DIR=experiments/runs
LOG_LEVEL=INFO
