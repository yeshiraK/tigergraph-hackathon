# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment and Secrets
.env
.env.*
!.env.example

# Testing and Quality Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.pyre/

# Data and Artifacts (Corpus source of truth protected; raw/processed data uncommitted)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Benchmark files: eval_hidden.jsonl is strictly ignored; eval_public.jsonl is included
data/benchmarks/*
!data/benchmarks/.gitkeep
!data/benchmarks/eval_public.jsonl
data/benchmarks/eval_hidden.jsonl

# Large data formats and embeddings
*.parquet
*.sqlite
*.db
*.npz

# Graph Exports, Indexes & Cache
graph/indexes/*
!graph/indexes/.gitkeep
graph/exports/*
!graph/exports/.gitkeep

# Experiment Runs, Logs & Telemetry Traces
experiments/runs/*
!experiments/runs/.gitkeep
!experiments/runs/agentic_graphrag_public_benchmark.json
!experiments/runs/agentic_graphrag_public_benchmark_llm_complete.json
!experiments/runs/tigergraph_nomic_public_benchmark.json
!experiments/runs/tigergraph_graphrag_public_benchmark.json
!experiments/runs/tigergraph_adaptive_graphrag_public_benchmark.json
experiments/runs/*hidden*

experiments/results/*
!experiments/results/.gitkeep
!experiments/results/metrics_dashboard.md
!results/metrics_dashboard.md

*.log
logs/
local/
tmp/
scratch/
private/
secrets/

# IDE and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
